generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String @unique
  passwordHash String
  country String @default("Nigeria")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  stats UserStats?
  sessions Session[]
  hostedDuels Duel[] @relation("DuelHost")
  joinedDuels Duel[] @relation("DuelGuest")
}

model Duel {
  id String @id @default(cuid())
  code String @unique
  hostId String
  guestId String?
  status String @default("WAITING")
  questionIds String[]
  hostIndex Int @default(0)
  guestIndex Int @default(0)
  hostScore Int @default(0)
  guestScore Int @default(0)
  hostCorrect Int @default(0)
  guestCorrect Int @default(0)
  hostFinishedAt DateTime?
  guestFinishedAt DateTime?
  startedAt DateTime?
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  host User @relation("DuelHost", fields: [hostId], references: [id], onDelete: Cascade)
  guest User? @relation("DuelGuest", fields: [guestId], references: [id], onDelete: SetNull)
  @@index([hostId])
  @@index([guestId])
  @@index([expiresAt])
}

model UserStats {
  id String @id @default(cuid())
  userId String @unique
  xp Int @default(0)
  gamesPlayed Int @default(0)
  correct Int @default(0)
  answers Int @default(0)
  bestStreak Int @default(0)
  gameStreak Int @default(0)
  dailyStreak Int @default(0)
  lastDaily DateTime?
  badges String[] @default([])
  categoryScores Json @default("{}")
  seenQuestionIds String[] @default([])
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}
